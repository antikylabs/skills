# Template for tests/.env — copy, then fill in.
#
#   cp .env.example .env
#
# .env is gitignored. This file is committed, so never put a real key here.

# ---------------------------------------------------------------------------
# Required for live runs only
# ---------------------------------------------------------------------------

# https://openrouter.ai/keys
# Only used by `npm run test:skill-behavior:live`. The default faux provider
# runs with --network=none and never reads this.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# faux (default) runs scripted turns offline and free.
# openrouter calls a real model and costs money.
# EVAL_PROVIDER=faux

# Which model live runs use. All support tool calling.
#   openai/gpt-5.6-luna               $0.10/M in, $0.60/M out   (default)
#   inclusionai/ling-3.0-flash:nitro  $0.021/$0.063, pinned to Novita
#   deepseek/deepseek-v4-flash-0731   ~$0.08/$0.18, routing unpinned
#   openai/gpt-oss-120b:nitro         $0.35/$0.75, pinned to Cerebras — fastest, weakest
# EVAL_MODEL=openai/gpt-5.6-luna

# Reasoning effort: off, minimal, low, medium, high, xhigh. Default off.
# Measured on the full paired suite: luna at off scores 34/45 against 36/45 at
# low, runs 5.6x faster and costs 27% less, and the skill delta is +20 either
# way. Reasoning helped both arms equally, so it is not what makes the skills
# work. Raise it only when investigating a case that fails for want of thinking.
# EVAL_THINKING=off

# Narrow the run to one case id, or a kind: trigger, audit, fix, reporting.
# EVAL_ONLY=audit

# Rebuild the container image before running. Needed after editing a skill,
# because the skill is baked into the image rather than mounted.
# EVAL_REBUILD=1
