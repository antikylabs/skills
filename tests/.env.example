# Template for tests/.env — copy, then fill in.
#
#   cp .env.example .env
#
# .env is gitignored. This file is committed, so never put a real key here.

# ---------------------------------------------------------------------------
# Required for live runs only
# ---------------------------------------------------------------------------

# https://openrouter.ai/keys
# Only used by `npm run test:skill-behavior:live`. The default faux provider
# runs with --network=none and never reads this.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# faux (default) runs scripted turns offline and free.
# openrouter calls a real model and costs money.
# EVAL_PROVIDER=faux

# Which model live runs use. Both support tool calling.
#   deepseek/deepseek-v4-flash   $0.14/M in, $0.28/M out   (default)
#   openai/gpt-5.6-luna          $0.10/M in, $0.60/M out
# EVAL_MODEL=deepseek/deepseek-v4-flash

# Reasoning effort: off, minimal, low, medium, high, xhigh. Default low.
# These cases test whether an agent loads a skill and follows a playbook, not
# whether it can reason to an answer, so a higher level mostly buys output
# tokens. Luna takes OpenAI-style reasoning_effort and honours low directly;
# deepseek sends no reasoning parameter below high, matching its own catalog.
# EVAL_THINKING=low

# Narrow the run to one case id, or a kind: trigger, audit, fix, reporting.
# EVAL_ONLY=audit

# Rebuild the container image before running. Needed after editing a skill,
# because the skill is baked into the image rather than mounted.
# EVAL_REBUILD=1
